# Kotobaseed edge — wildcard TLS via Cloudflare DNS-01.
#
# Routes:
#   api.{$PLATFORM_APEX}            → backend
#   {$PLATFORM_APEX}, *.{$PLATFORM_APEX} → frontend (SPA)
#
# Wildcard certs need DNS-01 because every tutor subdomain shares one
# cert. The CLOUDFLARE_API_TOKEN must be scoped to Zone:Read + DNS:Edit
# for the kotobaseed.net zone.
#
# PLATFORM_APEX defaults to kotobaseed.net but can be overridden via the
# environment so the same Caddyfile boots in staging on a different host.

{
    # Email Let's Encrypt uses for expiry notifications.
    email {$LETSENCRYPT_EMAIL}

    # On-demand TLS — gates cert issuance through the backend so we
    # only ever attempt Let's Encrypt for hostnames that have been
    # verified as a tutor's custom domain. Without the ask gate, anyone
    # could DOS our cert pipeline by pointing arbitrary DNS at us.
    on_demand_tls {
        ask http://backend:8000/internal/caddy/check-domain
    }
}

# --- API host (apex.api.) --------------------------------------------
api.{$PLATFORM_APEX} {
    tls {
        dns cloudflare {$CLOUDFLARE_API_TOKEN}
    }

    encode zstd gzip

    # Raw client IP is needed by slowapi rate limiting + audit logging.
    # uvicorn is launched with --proxy-headers so it honours these.
    reverse_proxy backend:8000 {
        header_up X-Forwarded-Proto {scheme}
        header_up X-Forwarded-For {remote_host}
        header_up X-Real-IP {remote_host}
    }
}

# --- Apex + wildcard tenant subdomains -------------------------------
# `*.kotobaseed.net` covers every tutor subdomain. The apex block is
# listed alongside the wildcard so both share the same TLS certificate.
*.{$PLATFORM_APEX}, {$PLATFORM_APEX} {
    tls {
        dns cloudflare {$CLOUDFLARE_API_TOKEN}
    }

    encode zstd gzip

    # Maintenance fallback. When the frontend (or anything in the
    # response chain) returns 5xx for a navigation request, serve the
    # branded maintenance page instead of Caddy's default 502.
    # /classroom/* is exempt — in-progress lessons must finish even if
    # we're mid-deploy. The page itself returns 503 so caching layers
    # know not to memoise this state.
    handle_errors {
        @5xx expression `int({err.status_code}) >= 500`
        @notClassroom not path /classroom/*
        handle @5xx {
            handle @notClassroom {
                reverse_proxy maintenance:80
            }
        }
    }

    # Stable branding assets on the APEX. Static integrations (BeeRanked
    # plugin slots) reference these — the path doesn't change on frontend
    # rebuilds the way /assets/Logo-<hash>.png does.
    @apex_branding {
        host {$PLATFORM_APEX}
        path /branding/*
    }
    handle @apex_branding {
        root * /srv
        file_server
    }

    # /news/* on the APEX ONLY (never on tutor subdomains). BeeRanked's
    # outbound-only agent syncs static blog + SEO content into the
    # shared `beeranked_content` volume; Caddy serves it directly so
    # the section lives as a subfolder of the root domain (best SEO
    # authority). Path is stripped before disk lookup because the agent
    # bakes URLs as `/news/...` but stores files flat under CONTENT_DIR.
    @apex_news {
        host {$PLATFORM_APEX}
        path /news /news/*
    }
    handle @apex_news {
        uri strip_prefix /news
        root * /srv/beeranked-content
        try_files {path} {path}/index.html
        file_server
    }

    # /api/* on the apex (and any tenant subdomain) forwards to the
    # backend with the /api prefix stripped. The SPA uses VITE_API_URL=/api
    # so it can talk to the API same-origin, which means the auth cookie
    # carries automatically and WebSockets work without a separate origin.
    # Must come BEFORE the SPA reverse_proxy below.
    handle_path /api/* {
        reverse_proxy backend:8000 {
            header_up X-Forwarded-Proto {scheme}
            header_up X-Forwarded-For {remote_host}
            header_up X-Real-IP {remote_host}
        }
    }

    # nginx in the frontend container serves the React SPA. The Host
    # header is preserved so the React shell can read it via
    # `window.location.host` and load the correct tenant.
    reverse_proxy frontend:80 {
        header_up Host {host}
        header_up X-Forwarded-Proto {scheme}
        header_up X-Forwarded-For {remote_host}
    }
}

# --- Canonical-domain redirects (per-tutor) --------------------------
# Tutors that own multiple TLDs / www variants and want one canonical
# brand URL set up redirects here. Specific blocks beat the catchall
# below.
#
# Vasso: .eu + www.* fold into the .com apex.
http://greekwithvasso.eu, http://www.greekwithvasso.eu, http://www.greekwithvasso.com {
    redir https://greekwithvasso.com{uri} 301
}

# --- Tutor custom domains (catch-all) --------------------------------
# Any hostname that didn't match the blocks above is treated as a
# potential custom-domain tutor site. Two ways tutors can wire it up:
#
#   1) DNS-only (no CDN):   they add an A record pointing here.
#                           Caddy provisions a Let's Encrypt cert via
#                           on-demand TLS, and they get HTTPS for free.
#   2) Cloudflare proxied:  they put their domain on CF with SSL mode
#                           "Flexible". CF terminates HTTPS at the edge
#                           and forwards plain HTTP to us. We accept on
#                           :80 with no cert needed.
#
# `on_demand_tls.ask` calls the backend to confirm the hostname is a
# verified `tutor.custom_domain` row before we ever attempt cert
# issuance. Without this, anyone could trigger Let's Encrypt issuance
# for arbitrary hostnames by pointing DNS at us — fast path to LE rate
# limits and to looking like an open relay.
:443, :80 {
    tls {
        on_demand
    }
    encode zstd gzip

    # Maintenance fallback — same as the apex block.
    handle_errors {
        @5xx expression `int({err.status_code}) >= 500`
        @notClassroom not path /classroom/*
        handle @5xx {
            handle @notClassroom {
                reverse_proxy maintenance:80
            }
        }
    }

    # API proxy. We honour the upstream X-Forwarded-Proto so the
    # backend can still tell HTTPS originals from CF-Flexible HTTP hops.
    handle_path /api/* {
        reverse_proxy backend:8000 {
            header_up X-Forwarded-Proto {http.request.header.X-Forwarded-Proto}
            header_up X-Forwarded-For {remote_host}
            header_up X-Real-IP {remote_host}
        }
    }

    # SPA shell. Host preserved so the tenancy middleware resolves it
    # to the right tutor via `tutor.custom_domain`.
    reverse_proxy frontend:80 {
        header_up Host {host}
        header_up X-Forwarded-Proto {http.request.header.X-Forwarded-Proto}
        header_up X-Forwarded-For {remote_host}
    }
}
