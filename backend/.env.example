# Copy this file to backend/.env and fill in the required values.
# Required keys crash the app at startup if missing.

# Environment
ENVIRONMENT=dev

# Database — Postgres in production, SQLite is fine locally
# DATABASE_URL=postgresql://user:pass@localhost:5432/kotobaseed
DATABASE_URL=sqlite:///./database.db
DB_ECHO=false

# Auth — required, no default
SECRET_KEY=replace-me-with-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Stripe — required, no default
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Optional Stripe products (subscriptions)
# STRIPE_PLUS_PRICE_ID=price_xxx
# STRIPE_PREMIUM_PRICE_ID=price_xxx
PLATFORM_FEE_PERCENT=0.15

# Frontend
FRONTEND_URL=http://localhost:5173

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional bootstrap admin (created on first startup if not present)
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=replace-me
