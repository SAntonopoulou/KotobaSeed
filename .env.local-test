# Local stack verification — values only used by docker-compose.local.yml.
# Real secrets stay in .env (gitignored). This file IS committed since it
# only contains test fixtures.
#
# Usage:
#   docker compose --env-file .env.local-test \
#       -f docker-compose.yml -f docker-compose.local.yml up --build

ENVIRONMENT=production
SECRET_KEY=local-stack-test-only-not-secure-change-in-prod

POSTGRES_USER=kotobaseed
POSTGRES_PASSWORD=local-postgres-pw
POSTGRES_DB=kotobaseed
REDIS_PASSWORD=local-redis-pw

# Caddy is disabled in the local stack, but compose still parses these.
CLOUDFLARE_API_TOKEN=local-test-not-used
LETSENCRYPT_EMAIL=local@test.invalid
PLATFORM_APEX=localhost
TENANT_SUBDOMAIN_SUFFIX=.localhost
VITE_API_URL=http://localhost:18000
FRONTEND_URL=http://localhost:18080

# Stripe test keys — leave blank for stack verification; checkout paths
# return 500s until you populate them, but the rest of the app works.
STRIPE_SECRET_KEY=sk_test_local_placeholder
STRIPE_WEBHOOK_SECRET=whsec_local_placeholder

ADMIN_EMAIL=sophia@example.com
ADMIN_PASSWORD=admin-local-only

# CORS allows the frontend host port.
CORS_ORIGINS=http://localhost:18080
CORS_ORIGIN_REGEX=^http://localhost:(18080|5173)$
