# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit secrets.

ENVIRONMENT=dev

# Required. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# sqlite for local dev; postgres://user:pass@host:5432/dbname for prod.
DATABASE_URL=sqlite:///./database.db

# Stripe — keys from dashboard.stripe.com → Developers → API keys.
# Use test-mode keys (sk_test_...) for dev. Switch to live keys for prod.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

FRONTEND_URL=http://localhost:5173

# Resend — required in prod, optional locally (sends are no-op'd when unset).
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@kotobaseed.net
RESEND_FROM_NAME=Kotobaseed
