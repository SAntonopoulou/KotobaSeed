# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit secrets.
#
# For production deployment, see DEPLOYMENT.md — it walks through every
# value with notes on which ones are required vs optional.

ENVIRONMENT=dev

# --- docker-compose stack (production) -------------------------------
# Only used when running `docker compose up`. The backend's DATABASE_URL
# and REDIS_URL further down are derived from these inside the compose
# file, so you set them once here.
POSTGRES_USER=kotobaseed
POSTGRES_PASSWORD=
POSTGRES_DB=kotobaseed
REDIS_PASSWORD=

# Cloudflare API token (Zone:Read + DNS:Edit for the apex). Used by
# Caddy for DNS-01 wildcard certificate issuance.
CLOUDFLARE_API_TOKEN=
LETSENCRYPT_EMAIL=
PLATFORM_APEX=kotobaseed.net
TENANT_SUBDOMAIN_SUFFIX=.kotobaseed.net
VITE_API_URL=https://api.kotobaseed.net


# --- Core ---
# Required. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Postgres in production; sqlite for local dev outside Docker. The
# docker-compose stack wires DATABASE_URL automatically — only set
# it here when running the backend directly (e.g. pytest, ad-hoc).
DATABASE_URL=sqlite:///./database.db
# Postgres example for reference:
# DATABASE_URL=postgresql+psycopg2://kotobaseed:CHANGEME@postgres:5432/kotobaseed

# Redis powers slowapi rate limiting + APScheduler signals when set.
# Leave blank for local dev to fall back to in-memory.
REDIS_URL=

FRONTEND_URL=http://localhost:5173

# --- Admin user (auto-seeded on first boot if no users exist) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Stripe ---
# Use test-mode keys (sk_test_...) for dev. Switch to live keys for prod.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Subscription Price IDs — leave blank to disable that tier. Run
# `python -m scripts.setup_stripe_products` to create them.
STRIPE_PLUS_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_BUSINESS_PRICE_ID=
STRIPE_PREMIUM_PRICE_ID=
PLATFORM_FEE_PERCENT=0.15

CONNECT_ONBOARDING_RETURN_URL=http://localhost:5173/onboarding/return
CONNECT_ONBOARDING_REFRESH_URL=http://localhost:5173/onboarding/refresh
DEFAULT_CONNECT_COUNTRY=GR
CONNECT_PAYOUT_DELAY_DAYS=14

# --- Resend (transactional email — optional locally, required in prod) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@kotobaseed.net
RESEND_FROM_NAME=Kotobaseed

# --- Daily.co (classroom video) ---
DAILY_API_KEY=
DAILY_DOMAIN=
CLASSROOM_ENABLE_RECORDING=false

# --- Tenancy / custom domains ---
PLATFORM_APEX=kotobaseed.net
TENANT_SUBDOMAIN_SUFFIX=.kotobaseed.net
RESERVED_SUBDOMAINS=www,api,admin
KOTOBASEED_SERVER_IP=
# MUST be false in prod — true is dev-only convenience.
CUSTOM_DOMAIN_AUTO_VERIFY=true

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ORIGIN_REGEX=^https?://([a-z0-9-]+\.)?localhost(:\d+)?$

# --- Scheduler ---
SCHEDULER_ENABLED=true
DORMANT_PAUSE_DAYS=30
DORMANT_CHECK_HOUR_UTC=4

# --- Backups (SQLite snapshot job) ---
BACKUP_DIR=/data/backups
BACKUP_RETENTION_DAYS=14

# --- Observability (optional) ---
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
